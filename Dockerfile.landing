# Evidra landing site: the static marketing/trust page from ui/, built and
# served as one image. This publishes the site only; it is not a release
# artifact and carries no evidence-path code (see docs/architecture.md).

FROM node:25-alpine AS build
WORKDIR /ui
# npm ci from the committed lockfile: the image proves the clean-install story
# on every build, exactly like the CI UI gate does.
COPY ui/package.json ui/package-lock.json ./
RUN npm ci
COPY ui/ ./
RUN npm run build

FROM nginx:1.29-alpine
COPY ui/landing.nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /ui/dist /usr/share/nginx/html
EXPOSE 80
